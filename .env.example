# PostgreSQL - ne jamais commiter de mot de passe reel.
# Remplacez USER et PASSWORD par vos identifiants locaux.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aodi_card?schema=public"

# URL publique canonique utilisee pour les profils, QR codes, liens NFC et partage.
# En production, utiliser uniquement une URL HTTPS, par exemple : https://aodicard.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"